# ExamSense Environment Configuration
# Add your Google Gemini API Key below to enable live AI analysis.
# Supports a single key or comma-separated pool for automatic key rotation on 429
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_key_1,your_key_2
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=sqlite:///./examsense.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=40
HOST=127.0.0.1
PORT=8000
